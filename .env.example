# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Clé API HenrikDev (gratuite, à demander sur leur Discord : https://discord.gg/X3GaVkX2YN)
HENRIK_API_KEY=

# Optionnel : ID d'un serveur de test pour enregistrer les commandes instantanément
DEV_GUILD_ID=

# Optionnel : requêtes/minute autorisées par ta clé HenrikDev (clé "Basic" = 30)
HENRIK_RATE_LIMIT=30
